# ReelTalk instance configuration.
# Copy to .env, then run ./setup.sh to generate the secrets and fill in DOMAIN.

# --- Required (setup.sh generates the three secrets) ---
DOMAIN=your-instance.example.com
SECRET_KEY=
POSTGRES_PASSWORD=
REDIS_PASSWORD=

# Postgres connection (these defaults match the standard docker compose layout)
POSTGRES_USER=reeltalk
POSTGRES_DB=reeltalk
POSTGRES_HOST=db

# --- HTTPS / Let's Encrypt ---
# https = nginx terminates TLS via Let's Encrypt (default when unset)
# reverse_proxy = an outer proxy handles TLS; pass plain http to nginx (local dev)
# NGINX_SETUP=reverse_proxy
# CERTBOT_EMAIL=you@example.com

# --- Email (optional; safe defaults let the site run without SMTP) ---
# EMAIL_HOST=localhost
# EMAIL_PORT=587
# EMAIL_HOST_USER=
# EMAIL_HOST_PASSWORD=
# EMAIL_SENDER_NAME=admin
# EMAIL_SENDER_DOMAIN=          # defaults to DOMAIN

# --- Optional overrides ---
# DEBUG=false
# ALLOWED_HOSTS=localhost,127.0.0.1,[::1]   # defaults to DOMAIN; add extra hostnames here if needed
# POSTGRES_SHM_SIZE=128mb
# DATA_UPLOAD_MAX_MEMORY_MiB=100
# TIME_ZONE=UTC
